<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#102a43"><title>@ViewData["Title"] - سامانه ارزیابی عملکرد</title><link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet">@RenderSection("Head",required:false)</head><body><div class="app-shell"><aside class="app-sidebar"><div class="sidebar-brand"><div class="brand-mark"><span></span><span></span><span></span></div><div><div class="brand-title">ایندامین سایپا</div><div class="brand-subtitle">سامانه ارزیابی عملکرد</div></div></div><div class="sidebar-section"><div class="sidebar-caption">دسترسی سریع</div><a class="nav-item" href="/"><span class="nav-icon">⌂</span><span>داشبورد</span></a>@if(User.FindFirst("EmployeeId")!=null){<a class="nav-item" href="/EmployeeDashboard"><span class="nav-icon">◉</span><span>داشبورد عملکرد من</span></a>@if(User.FindFirst("IsEvaluator")?.Value=="1"){<a class="nav-item" href="/Evaluation"><span class="nav-icon">✓</span><span>ارزیابی کارکنان</span></a>}}</div>@if(User.HasClaim("IsAdmin","1")){<div class="sidebar-section"><div class="sidebar-caption">مدیریت سامانه</div><a class="nav-item" href="/Admin/Periods"><span class="nav-icon">▣</span><span>دوره‌های ارزیابی</span></a><a class="nav-item" href="/Admin/Employees"><span class="nav-icon">◌</span><span>مدیریت کارکنان</span></a><a class="nav-item" href="/Admin/ImportEmployees"><span class="nav-icon">⇧</span><span>ورود کارکنان از Excel</span></a><a class="nav-item" href="/Setup/Questions"><span class="nav-icon">?</span><span>بانک سؤالات</span></a><a class="nav-item" href="/Setup/Positions"><span class="nav-icon">☷</span><span>رده‌های پستی</span></a><a class="nav-item" href="/Setup/OrgUnits"><span class="nav-icon">⌘</span><span>ساختار سازمانی</span></a><a class="nav-item" href="/Reports"><span class="nav-icon">▥</span><span>گزارش‌های مدیریتی</span></a></div>}<div class="sidebar-footer"><div class="footer-dot"></div><div><div class="footer-title">وضعیت سامانه</div><div class="footer-status">در حال سرویس‌دهی</div></div></div></aside><div class="app-main"><header class="app-topbar"><div class="topbar-left"><button class="mobile-menu" type="button" aria-label="منو">☰</button><div><div class="topbar-overline">سامانه یکپارچه منابع انسانی</div><div class="topbar-title">@ViewData["Title"]</div></div></div><div class="topbar-user"><div class="user-avatar">@((User.Identity?.Name??"ک").Trim().FirstOrDefault())</div><div class="user-meta"><strong>@(User.Identity?.Name??"کاربر")</strong><span>@(User.HasClaim("IsAdmin","1")?"مدیر سیستم":(User.FindFirst("IsEvaluator")?.Value=="1"?"ارزیاب":"کارمند"))</span></div><form method="post" action="/Account/Logout" class="ms-2">@Html.AntiForgeryToken()<button class="btn btn-logout">خروج</button></form></div></header><main class="app-content">@if(TempData["Result"]!=null){<div class="alert app-alert"><span>✓</span>@TempData["Result"]</div>}@if(TempData["Error"]!=null){<div class="alert app-alert app-alert-error"><span>!</span>@TempData["Error"]</div>}@RenderBody()</main><footer class="app-footer"><span>سامانه ارزیابی عملکرد کارکنان</span><span>© ایندامین سایپا</span></footer></div></div><div class="sidebar-overlay"></div><script src="~/js/site.js"></script><script src="~/js/jalali-datepicker.js"></script>@RenderSection("Scripts",required:false)</body></html>