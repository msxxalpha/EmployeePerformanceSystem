<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] - سامانه ارزیابی عملکرد</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet">@RenderSection("Head",required:false)</head><body><header class="topbar"><div class="container-fluid d-flex justify-content-between align-items-center"><a class="brand" href="/">سامانه ارزیابی عملکرد کارکنان</a><div>@if(User.Identity?.IsAuthenticated==true){<span>@User.Identity.Name</span> <form class="d-inline" method="post" action="/Account/Logout"><input name="__RequestVerificationToken" type="hidden" value="@Antiforgery.GetTokens(Context).RequestToken"/><button class="btn btn-sm btn-light">خروج</button></form>}</div></div></header><div class="container-fluid"><div class="row"><aside class="col-lg-2 sidebar"><a href="/">داشبورد من</a>@if(User.FindFirst("EmployeeId")!=null){<a href="/EmployeeDashboard">گزارش عملکرد من</a>}@if(User.FindFirst("EmployeeId")!=null && User.FindFirst("IsAdmin")?.Value!="1"){<a href="/Evaluation">ارزیابی کارکنان</a>}@if(User.HasClaim("IsAdmin","1")){<hr><a href="/Admin/Periods">دوره‌های ارزیابی</a><a href="/Admin/Employees">کارکنان</a><a href="/Admin/ImportEmployees">ورود از Excel</a><a href="/Setup/Positions">رده‌های پستی و سوالات</a><a href="/Setup/OrgUnits">ساختار سازمانی</a><a href="/Reports">گزارش‌ها</a>}</aside><main class="col-lg-10 py-4">@RenderBody()</main></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js"></script>@RenderSection("Scripts",required:false)</body></html>