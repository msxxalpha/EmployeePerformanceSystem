@model List<Indamin.Performance.Controllers.ReportsController.Row>
@{ ViewData["Title"] = "گزارش ارزیابی"; }<div class="d-flex justify-content-between mb-3"><h2>گزارش ارزیابی</h2><a class="btn btn-outline-primary" href="/Reports/Export?periodId=@ViewBag.PeriodId">خروجی Excel</a></div><form method="get" class="mb-3"><select name="periodId" class="form-select" onchange="this.form.submit()"><option value="">انتخاب دوره</option>@foreach(var p in (List<EvaluationPeriod>)ViewBag.Periods){<option value="@p.Id" selected="@(p.Id==(int)ViewBag.PeriodId)">@p.Title</option>}</select></form><div class="table-responsive"><table class="table table-hover"><thead><tr><th>کارمند</th><th>ارزیاب</th><th>واحد</th><th>رده</th><th>امتیاز</th><th>سقف</th><th>درصد</th><th>وضعیت</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Employee</td><td>@x.Evaluator</td><td>@x.Unit</td><td>@x.Position</td><td>@x.Score</td><td>@x.Max</td><td>@(x.Max==0?0:Math.Round(x.Score*100/x.Max,2))%</td><td>@x.Status</td></tr>}</tbody></table></div>