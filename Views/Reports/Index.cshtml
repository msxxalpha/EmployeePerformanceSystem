@model List<Indamin.Performance.Controllers.ReportsController.Row>
@{ViewData["Title"]="گزارش ارزیابی";}
<div class="page-header"><div><div class="eyebrow">گزارش مدیریتی</div><h2>نتایج ارزیابی</h2><p class="text-muted">نتایج دوره منتخب، قابل جست‌وجو، مرتب‌سازی و دریافت در Excel.</p></div><a class="btn btn-main" href="/Reports/Export?periodId=@ViewBag.PeriodId">خروجی Excel</a></div>
<div class="toolbar"><form method="get" class="d-flex gap-2 align-items-center flex-wrap"><select name="periodId" class="form-select" style="min-width:220px" onchange="this.form.submit()"><option value="">انتخاب دوره</option>@foreach(var p in (List<EvaluationPeriod>)ViewBag.Periods){<option value="@p.Id" selected="@(p.Id==(int)ViewBag.PeriodId)">@p.Title</option>}</select></form><input class="form-control table-search" style="max-width:340px" data-table-filter="#reports" placeholder="جستجوی کارمند، ارزیاب، واحد یا رده..."></div>
<div class="table-panel"><div class="table-responsive"><table id="reports" class="table modern-table"><thead><tr><th>کارمند</th><th>ارزیاب</th><th>واحد</th><th>رده</th><th>امتیاز</th><th>سقف</th><th>درصد</th><th>وضعیت</th></tr></thead><tbody>@foreach(var x in Model){<tr><td class="fw-bold">@x.Employee</td><td>@x.Evaluator</td><td>@x.Unit</td><td>@x.Position</td><td>@x.Score</td><td>@x.Max</td><td><span class="score-pill">@(x.Max==0?0:Math.Round(x.Score*100/x.Max,1))٪</span></td><td>@x.Status</td></tr>}</tbody></table></div></div>