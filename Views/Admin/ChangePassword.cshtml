@model AdminController.AdminChangePasswordVm
@{
    ViewData["Title"] = "تغییر رمز عبور کاربر";
}
<div class="page-header">
    <div>
        <div class="eyebrow">مدیریت دسترسی</div>
        <h2>تغییر رمز عبور کاربر</h2>
        <p class="text-muted">مدیر سیستم می‌تواند رمز ورود هر کارمند را تنظیم یا بازنشانی کند.</p>
    </div>
    <div class="toolbar-actions">
        <a href="/Admin/Employees" class="btn btn-outline-secondary">بازگشت به کارکنان</a>
    </div>
</div>
<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-8">
        <div class="table-panel p-4">
            <div class="alert alert-light border mb-4">
                <div><strong>کارمند:</strong> @Model.EmployeeName</div>
                <div><strong>شماره پرسنلی:</strong> @Model.PersonnelNo</div>
                <div><strong>وضعیت:</strong> @(Model.EmployeeIsActive ? "فعال" : "غیرفعال")</div>
            </div>
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EmployeeId" />
                <input type="hidden" asp-for="EmployeeName" />
                <input type="hidden" asp-for="PersonnelNo" />
                <input type="hidden" asp-for="HasUser" />
                <input type="hidden" asp-for="EmployeeIsActive" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">رمز عبور جدید</label>
                    <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                    <div class="form-hint mt-1">حداقل ۸ کاراکتر. این رمز جایگزین رمز قبلی خواهد شد.</div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">تکرار رمز عبور جدید</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <div class="toolbar-actions">
                    <button type="submit" class="btn btn-main">ذخیره رمز جدید</button>
                    <a href="/Admin/Employees" class="btn btn-outline-secondary">انصراف</a>
                </div>
            </form>
        </div>
    </div>
</div>
