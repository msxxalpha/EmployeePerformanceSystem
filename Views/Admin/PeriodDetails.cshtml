@model AdminController.PeriodDetailsVm
@{ViewData["Title"]="جزئیات دوره";}
<div class="page-header"><div><div class="eyebrow">دوره ارزیابی</div><h2>@Model.Period.Title</h2><p class="text-muted">@Model.Period.StartJalali تا @Model.Period.EndJalali</p></div><div class="toolbar-actions">@if(!Model.Period.IsDeleted){<a class="btn btn-outline-secondary" href="/Admin/EditPeriod?id=@Model.Period.Id">ویرایش</a>}<a class="btn btn-outline-primary" href="/Admin/Periods">بازگشت</a></div></div>
<div class="row g-3 mb-4">
<div class="col-md-4"><div class="metric-card"><span>وضعیت</span><strong>@(Model.Period.IsOpen && Model.Period.EndAt>=DateTime.Now?"فعال":"بسته")</strong><small>بر اساس ساعت سیستم</small></div></div>
<div class="col-md-4"><div class="metric-card"><span>ارزیابی‌های ثبت‌شده</span><strong>@Model.Evaluations.Count</strong><small>در این دوره</small></div></div>
<div class="col-md-4"><div class="metric-card"><span>میانگین درصد</span><strong>@(Model.Evaluations.Count==0?0:Math.Round(Model.Evaluations.Where(x=>x.Max>0).Select(x=>x.Score/x.Max*100).DefaultIfEmpty().Average(),1))٪</strong><small>درصد از سقف هر فرد</small></div></div>
</div>
<div class="table-panel"><div class="toolbar"><form class="toolbar" method="get" action="/Admin/PeriodDetails"><input type="hidden" name="id" value="@Model.Period.Id"><input class="form-control" name="q" value="@Model.Search" placeholder="جست‌وجوی کارمند، پرسنلی، واحد یا ارزیاب..."><select class="form-select page-size-select" name="pageSize" onchange="this.form.submit()"><option value="25" selected="@(Model.PageSize==25)">25 ردیف</option><option value="50" selected="@(Model.PageSize==50)">50 ردیف</option><option value="75" selected="@(Model.PageSize==75)">75 ردیف</option><option value="100" selected="@(Model.PageSize==100)">100 ردیف</option></select><button class="btn btn-outline-primary" type="submit">جست‌وجو</button></form><span class="form-hint">تعداد نتایج: @Model.TotalCount</span></div>
@{var totalPages=Math.Max(1,(int)Math.Ceiling(Model.TotalCount/(double)Model.PageSize));}
@await Html.PartialAsync("_TablePagination",(Model.Page,totalPages,Model.PageSize,Model.Search??"","/Admin/PeriodDetails",$"id={Model.Period.Id}"))
<div class="table-responsive"><table id="periodDetails" class="table modern-table"><thead><tr><th>کارمند</th><th>پرسنلی</th><th>واحد</th><th>رده</th><th>ارزیاب</th><th>امتیاز</th><th>درصد</th><th>وضعیت</th><th></th></tr></thead><tbody>
@foreach(var x in Model.Evaluations){<tr><td class="fw-bold">@x.Employee</td><td>@x.PersonnelNo</td><td>@x.Unit</td><td>@x.Position</td><td>@x.Evaluator</td><td>@x.Score / @x.Max</td><td><span class="score-pill">@(x.Max==0?0:Math.Round(x.Score*100/x.Max,1))٪</span></td><td>@x.Status</td><td><a class="btn btn-sm btn-outline-primary" href="/Admin/EvaluationDetails?id=@x.EvaluationId">جزئیات</a></td></tr>}</tbody></table></div>
@await Html.PartialAsync("_TablePagination",(Model.Page,totalPages,Model.PageSize,Model.Search??"","/Admin/PeriodDetails",$"id={Model.Period.Id}"))
</div>
