@model AdminController.EvaluationDetailsVm
@{ ViewData["Title"]="جزئیات ارزیابی"; }
<div class="page-header"><div><div class="eyebrow">جزئیات ارزیابی</div><h2>@Model.Employee?.FullName</h2><p class="text-muted">@Model.Employee?.PersonnelNo · @Model.Evaluation.Period?.Title · ارزیاب: @Model.Evaluator</p></div><a class="btn btn-outline-secondary" href="/Admin/PeriodDetails?id=@Model.Evaluation.PeriodId">بازگشت به دوره</a></div>
<div class="row g-3 mb-4">
<div class="col-md-4"><div class="metric-card metric-main"><span>امتیاز نهایی</span><strong>@Model.Evaluation.FinalScore.ToString("0.##")</strong><small>از @Model.Evaluation.FinalMaxScore.ToString("0.##")</small></div></div>
<div class="col-md-4"><div class="metric-card"><span>درصد عملکرد</span><strong>@(Model.Evaluation.FinalMaxScore==0?0:Math.Round(Model.Evaluation.FinalScore*100/Model.Evaluation.FinalMaxScore,1))٪</strong><small>دوره @Model.Evaluation.Period?.Title</small></div></div>
<div class="col-md-4"><div class="metric-card"><span>تعداد سؤال</span><strong>@Model.Scores.Count</strong><small>با سقف امتیاز ثبت‌شده</small></div></div>
</div>
<div class="table-panel mb-4"><div class="panel-title"><div><h4>امتیازهای سؤالات</h4><span>اطلاعات ثبت‌شده در دوره منتخب؛ این صفحه صرفاً برای مشاهده است.</span></div></div>
<div class="table-responsive"><table class="table modern-table"><thead><tr><th>کد</th><th>عنوان</th><th>حوزه</th><th>امتیاز</th><th>سقف</th><th>درصد</th><th>توضیح</th></tr></thead><tbody>@foreach(var s in Model.Scores){<tr><td><span class="code-chip">@s.Code</span></td><td class="fw-bold">@s.Title</td><td><span class="domain-chip">@s.Domain</span></td><td>@s.Score</td><td>@s.MaxScore</td><td><span class="score-pill">@(s.MaxScore==0?0:Math.Round(s.Score*100/s.MaxScore,1))٪</span></td><td class="text-muted">@(string.IsNullOrWhiteSpace(s.Comment)?"—":s.Comment)</td></tr>}</tbody></table></div></div>
<div class="table-panel"><div class="panel-title"><div><h4>تاریخچه تغییرات امتیاز</h4><span>هر تغییر ثبت‌شده به همراه علت آن.</span></div></div>
@if(Model.History.Count==0){<div class="empty-inline">تغییری بعد از ثبت اولیه برای این ارزیابی ثبت نشده است.</div>}else{<div class="table-responsive"><table class="table modern-table"><thead><tr><th>سؤال</th><th>قبلی</th><th>جدید</th><th>ثبت‌کننده</th><th>تاریخ</th><th>علت</th></tr></thead><tbody>@foreach(var h in Model.History){<tr><td>@h.QuestionTitle</td><td>@h.OldScore</td><td>@h.NewScore</td><td>@h.ChangedBy</td><td>@h.ChangedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@h.Reason</td></tr>}</tbody></table></div>}</div>