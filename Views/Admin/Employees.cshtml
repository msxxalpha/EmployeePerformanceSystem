@model List<Employee>
@{ ViewData["Title"]="مدیریت کارکنان"; }
<div class="page-header"><div><div class="eyebrow">مدیریت منابع انسانی</div><h2>کارکنان</h2><p class="text-muted">افزودن، ویرایش و غیرفعال‌سازی کارکنان و حساب ورود آنها.</p></div><div class="toolbar-actions"><a class="btn btn-main" href="/Admin/CreateEmployee">+ افزودن کارمند</a><a class="btn btn-outline-primary" href="/Admin/ImportEmployees">ورود Excel</a><a class="btn btn-outline-secondary" href="/Admin/ExportEmployees">خروجی Excel</a></div></div>
<div class="toolbar"><input class="form-control" data-table-filter="#employees" placeholder="جست‌وجوی نام، پرسنلی یا کد ملی..."><span class="form-hint">تعداد کارکنان: @Model.Count</span></div>
<div class="table-panel"><div class="table-responsive"><table id="employees" class="table modern-table"><thead><tr><th>پرسنلی</th><th>نام</th><th>رده</th><th>واحد</th><th>ارزیاب</th><th>سرپرست</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody>
@foreach(var e in Model){<tr>
<td><span class="code-chip">@e.PersonnelNo</span></td><td class="fw-bold">@e.FullName</td><td>@e.Position?.Title</td><td>@e.Unit?.Title</td><td>@(e.IsEvaluator?"بله":"خیر")</td><td>@e.SupervisorId</td><td><span class="status-chip @(e.IsActive?"status-open":"status-closed")">@(e.IsActive?"فعال":"غیرفعال")</span></td>
<td><div class="toolbar-actions"><a class="btn btn-sm btn-outline-primary" href="/Admin/EditEmployee?id=@e.Id">ویرایش</a>@if(e.IsActive){<form method="post" action="/Admin/DeactivateEmployee" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">غیرفعال‌سازی</button></form>}else{<form method="post" action="/Admin/ActivateEmployee" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"><button class="btn btn-sm btn-main" type="submit">فعال‌سازی</button></form>}</div></td>
</tr>}
</tbody></table></div></div>