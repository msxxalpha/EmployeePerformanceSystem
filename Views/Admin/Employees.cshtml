@model List<Employee>
@{ ViewData["Title"] = "کارکنان"; }<div class="d-flex justify-content-between mb-3"><h2>کارکنان</h2><div><a class="btn btn-outline-primary" href="/Admin/ImportEmployees">ورود Excel</a><a class="btn btn-outline-secondary" href="/Admin/ExportEmployees">خروجی Excel</a></div></div><input class="form-control mb-3" placeholder="جستجو..." data-table-filter="#employees"><table id="employees" class="table table-hover"><thead><tr><th>پرسنلی</th><th>نام</th><th>رده</th><th>واحد</th><th>ارزیاب</th><th>سرپرست</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.PersonnelNo</td><td>@e.FullName</td><td>@e.Position?.Title</td><td>@e.Unit?.Title</td><td>@(e.IsEvaluator?"بله":"خیر")</td><td>@e.SupervisorId</td></tr>}</tbody></table>