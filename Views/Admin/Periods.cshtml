@model List<EvaluationPeriod>
@{ ViewData["Title"] = "دوره‌های ارزیابی"; }
<h2>دوره‌های ارزیابی</h2><div class="card p-3 mb-4"><form method="post" action="/Admin/CreatePeriod" class="row g-2"><div class="col-md-3"><input name="title" class="form-control" placeholder="عنوان دوره" required></div><div class="col-md-3"><input name="startJalali" class="form-control" placeholder="شروع: 1405/06/21" required></div><div class="col-md-3"><input name="endJalali" class="form-control" placeholder="پایان: 1405/06/25" required></div><div class="col-md-3"><input name="description" class="form-control" placeholder="توضیحات"></div><div class="col-12"><button class="btn btn-main">ایجاد دوره</button></div></form></div><table class="table"><thead><tr><th>عنوان</th><th>شروع</th><th>پایان</th><th>فعال</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Title</td><td>@p.StartJalali</td><td>@p.EndJalali</td><td>@(p.IsOpen?"بله":"خیر")</td></tr>}</tbody></table>