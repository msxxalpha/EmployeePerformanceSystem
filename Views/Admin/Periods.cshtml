@model List<EvaluationPeriod>
@{ ViewData["Title"]="دوره‌های ارزیابی"; var now=DateTime.Now; }
<div class="page-header">
<div><div class="eyebrow">پیکربندی</div><h2>دوره‌های ارزیابی</h2><p class="text-muted">تعریف، ویرایش، مشاهده جزئیات و غیرفعال‌سازی دوره‌های ماهیانه.</p></div>
<div class="toolbar-actions"><a class="btn btn-outline-secondary" href="/Admin/ExportPeriods">خروجی Excel</a><a class="btn btn-main" href="#new-period">+ دوره جدید</a></div>
</div>
<div id="new-period" class="form-panel mb-4"><div class="panel-title"><div><h4>تعریف دوره جدید</h4><span>تاریخ‌ها با تقویم هجری شمسی انتخاب می‌شوند.</span></div><span class="panel-badge">بر مبنای تاریخ سیستم</span></div>
<form method="post" action="/Admin/CreatePeriod" class="row g-3">@Html.AntiForgeryToken()
<div class="col-lg-3 col-md-6"><label class="form-label">عنوان دوره *</label><input name="title" class="form-control" placeholder="شهریور ۱۴۰۵" required></div>
<div class="col-lg-3 col-md-6"><label class="form-label">تاریخ شروع *</label><div class="jalali-input"><input name="startJalali" class="form-control" data-jalali-date required><button type="button" class="date-trigger" data-jalali-trigger>▣</button></div></div>
<div class="col-lg-3 col-md-6"><label class="form-label">تاریخ پایان *</label><div class="jalali-input"><input name="endJalali" class="form-control" data-jalali-date required><button type="button" class="date-trigger" data-jalali-trigger>▣</button></div></div>
<div class="col-lg-3 col-md-6"><label class="form-label">توضیحات</label><input name="description" class="form-control"></div>
<div class="col-12 d-flex justify-content-end"><button class="btn btn-main px-4">ایجاد دوره</button></div></form></div>
<div class="table-panel"><div class="toolbar"><input class="form-control" data-table-filter="#periods" placeholder="جست‌وجوی دوره..."><span class="form-hint">تعداد: @Model.Count</span></div>
<div class="table-responsive"><table id="periods" class="table modern-table"><thead><tr><th>عنوان</th><th>شروع</th><th>پایان</th><th>وضعیت</th><th>توضیحات</th><th>عملیات</th></tr></thead><tbody>
@foreach(var p in Model){var active=p.IsOpen&&p.EndAt>=now;var started=p.StartAt<=now; <tr><td class="fw-bold">@p.Title</td><td>@p.StartJalali</td><td>@p.EndJalali</td><td><span class="status-chip @(active?"status-open":"status-closed")">@(active?(started?"فعال و قابل ثبت":"فعال و در انتظار شروع"):"بسته")</span></td><td class="text-muted">@(string.IsNullOrWhiteSpace(p.Description)?"—":p.Description)</td><td><div class="toolbar-actions"><a class="btn btn-sm btn-outline-primary" href="/Admin/PeriodDetails?id=@p.Id">جزئیات</a><a class="btn btn-sm btn-outline-secondary" href="/Admin/EditPeriod?id=@p.Id">ویرایش</a>@if(active){<form method="post" action="/Admin/DeactivatePeriod" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">غیرفعال</button></form>}</div></td></tr> }
</tbody></table></div></div>