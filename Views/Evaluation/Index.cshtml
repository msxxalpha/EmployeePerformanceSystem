@model List<EvaluationController.Row>
@{ ViewData["Title"]="ارزیابی کارکنان"; var period=(EvaluationPeriod?)ViewBag.Period; }
<div class="page-header"><div><div class="eyebrow">اجرای ارزیابی</div><h2>زیرمجموعه ارزیاب</h2><p class="text-muted">تمام زیرمجموعه سلسله‌مراتبی شما در این فهرست قرار می‌گیرد.</p></div><a class="btn btn-outline-primary" href="/Evaluation/ExportMyList">خروجی Excel</a></div>
@if(period!=null){<div class="period-banner"><div><span>دوره</span><strong>@period.Title</strong></div><div><span>بازه</span><b>@period.StartJalali تا @period.EndJalali</b></div><div><span>وضعیت</span><b>@(period.IsOpen&&DateTime.Now>=period.StartAt&&DateTime.Now<=period.EndAt?"قابل ثبت":"فقط مشاهده")</b></div></div>}
<div class="toolbar"><input class="form-control table-search" data-table-filter="#evals" placeholder="جستجوی نام، پرسنلی، رده یا واحد..."><span class="form-hint">تعداد افراد: @Model.Count</span></div>
<div class="table-panel"><div class="table-responsive"><table id="evals" class="table modern-table"><thead><tr><th>کارمند</th><th>پرسنلی</th><th>رده</th><th>واحد</th><th>ارزیاب جاری</th><th>امتیاز نهایی</th><th>درصد</th><th>وضعیت</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td class="fw-bold">@x.Name @if(x.IsEvaluator){<span class="mini-tag">ارزیاب</span>}</td><td>@x.PersonnelNo</td><td>@x.Position</td><td>@x.Unit</td><td>@x.CurrentEvaluator</td><td>@x.Total.ToString("0.##") / @x.Max.ToString("0.##")</td><td><span class="score-pill">@x.Percentage.ToString("0.0")٪</span></td><td>@x.Status</td><td><a class="btn btn-sm btn-main" href="/Evaluation/Form?id=@x.Id">@((x.Status=="ثبت نشده")?"ارزیابی":"مشاهده / بازنگری")</a></td></tr>}</tbody></table></div></div>