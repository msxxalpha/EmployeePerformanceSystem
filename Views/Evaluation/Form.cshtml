@model Indamin.Performance.Controllers.EvaluationController.FormVm
@{ ViewData["Title"] = "فرم ارزیابی"; }
<div class="d-flex justify-content-between"><div><h2>ارزیابی @Model.Employee.FullName</h2><div class="text-muted">دوره: @Model.Period.Title | رده پستی: @Model.Employee.Position?.Title</div></div><a href="/Evaluation" class="btn btn-outline-secondary">بازگشت</a></div>
@if(Model.Notice!=null){<div class="alert alert-warning mt-3">@Model.Notice</div>}
<form method="post" class="mt-3"><input type="hidden" name="EmployeeId" value="@Model.Employee.Id" /><input type="hidden" name="PositionId" value="@Model.Employee.PositionId" />
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>سؤال</th><th>حداکثر</th><th>امتیاز</th><th>توضیحات</th></tr></thead><tbody>@foreach(var q in Model.Questions){var old=Model.Evaluation?.Scores.FirstOrDefault(s=>s.QuestionId==q.Id);<tr><td>@q.Text</td><td>@q.MaxScore</td><td><input class="form-control" type="number" step="0.01" min="0" max="@q.MaxScore" name="Scores[@q.Id]" value="@(old?.Score??0)" @(Model.CanEdit?"":"readonly") /></td><td><input class="form-control" name="Comments[@q.Id]" value="@old?.Comment" @(Model.CanEdit?"":"readonly") /></td></tr>}</tbody></table></div>
@if(Model.CanEdit){<button class="btn btn-main" type="submit">ثبت و نهایی‌سازی ارزیابی</button>}</form>
@if(Model.History.Count>0){<hr><h5>تاریخچه تغییر امتیازها</h5><table class="table table-sm"><thead><tr><th>سؤال</th><th>قبلی</th><th>جدید</th><th>تغییردهنده</th><th>تاریخ</th><th>علت</th></tr></thead><tbody>@foreach(var h in Model.History){<tr><td>@h.QuestionId</td><td>@h.OldScore</td><td>@h.NewScore</td><td>@h.ChangedBy</td><td>@h.ChangedAt</td><td>@h.Reason</td></tr>}</tbody></table>}