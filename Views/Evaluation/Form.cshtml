@model EvaluationController.FormVm
@{ ViewData["Title"]="فرم ارزیابی"; }
<div class="page-header"><div><div class="eyebrow">فرم ارزیابی ماهیانه</div><h2>@Model.Employee.FullName</h2><p class="text-muted">@Model.Employee.PersonnelNo · @Model.Employee.Position?.Title · @Model.Period.Title</p></div><a href="/Evaluation" class="btn btn-outline-secondary">بازگشت</a></div>
<div class="score-summary"><div><span>امتیاز نهایی</span><strong>@Model.FinalScore.ToString("0.##")</strong><small>از @Model.FinalMaxScore.ToString("0.##")</small></div><div><span>درصد</span><strong>@(Model.FinalMaxScore>0?Math.Round(Model.FinalScore*100/Model.FinalMaxScore,1):0)٪</strong><small>@(Model.CanEdit?"قابل ویرایش":"فقط مشاهده")</small></div><div><span>تعداد سؤال</span><strong>@Model.Questions.Count</strong><small>براساس رده پستی</small></div></div>
@if(Model.Notice!=null){<div class="alert app-alert app-alert-warn"><span>!</span>@Model.Notice</div>}
<form method="post">@Html.AntiForgeryToken()<input type="hidden" name="EmployeeId" value="@Model.Employee.Id">
<div class="table-panel mt-3"><div class="table-responsive"><table class="table modern-table"><thead><tr><th>#</th><th>سؤال</th><th>حوزه</th><th>شرح</th><th>سقف</th><th>امتیاز</th><th>توضیح ارزیاب</th></tr></thead><tbody>@foreach(var q in Model.Questions.OrderBy(x=>x.SortOrder)){<tr><td>@q.SortOrder</td><td><b>@q.Title</b><div class="question-code">@q.Code</div></td><td><span class="domain-chip">@q.Domain</span></td><td class="text-muted">@(q.Description??"—")</td><td>@q.MaxScore</td><td><input class="form-control score-input" type="number" step="0.01" min="0" max="@q.MaxScore" name="Scores[@q.QuestionId]" value="@q.Score.ToString("0.##")" @(Model.CanEdit?"":"readonly")></td><td><input class="form-control" name="Comments[@q.QuestionId]" value="@q.Comment" placeholder="توضیح..." @(Model.CanEdit?"":"readonly")></td></tr>}</tbody></table></div></div>
@if(Model.CanEdit){<div class="form-footer"><span class="form-hint">سقف امتیاز هر سؤال در همین فرم نمایش داده می‌شود.</span><button class="btn btn-main px-4">ثبت و نهایی‌سازی</button></div>}</form>
@if(Model.History.Count>0){<div class="table-panel mt-4"><div class="panel-title"><div><h4>تاریخچه تغییرات امتیاز</h4><span>تغییرات قبلی حفظ شده و قابل رهگیری است.</span></div></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>سؤال</th><th>قبلی</th><th>جدید</th><th>ثبت‌کننده</th><th>تاریخ</th><th>علت</th></tr></thead><tbody>@foreach(var h in Model.History){<tr><td>@h.QuestionTitle</td><td>@h.OldScore</td><td>@h.NewScore</td><td>@h.ChangedBy</td><td>@h.ChangedAt</td><td>@h.Reason</td></tr>}</tbody></table></div></div>}