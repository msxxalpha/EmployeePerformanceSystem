@model AccountController.LoginVm
<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ورود به سامانه ارزیابی عملکرد</title><link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet"></head><body class="login-page"><div class="login-card"><div class="login-logo">↗</div><div class="text-center mb-4"><div class="eyebrow">ایندامین سایپا</div><h2>سامانه ارزیابی عملکرد</h2><p class="text-muted">ورود امن به داشبورد شخصی و مدیریتی</p></div><form method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="returnUrl"><div asp-validation-summary="All" class="text-danger small mb-3"></div><div class="mb-3"><label class="form-label">نام کاربری</label><input asp-for="UserName" class="form-control" autocomplete="username" placeholder="شماره پرسنلی یا admin"></div><div class="mb-4"><label class="form-label">رمز عبور</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="کد ملی / رمز عبور"></div><button class="btn btn-main w-100 py-2">ورود به سامانه</button></form><div class="login-help"><b>کارکنان:</b> نام کاربری شماره پرسنلی و رمز اولیه کد ملی است.<br><b>ارزیاب:</b> پس از ورود، منوی ارزیابی کارکنان فعال می‌شود.</div></div></body></html>