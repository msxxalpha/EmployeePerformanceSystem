@model Indamin.Performance.Controllers.AccountController.LoginVm
<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ورود</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet"></head><body class="login-page"><div class="login-card"><div class="text-center mb-4"><h2>سامانه ارزیابی عملکرد</h2><p class="text-muted">ورود ارزیاب / مدیر سیستم</p></div><form method="post"><div asp-validation-summary="All" class="text-danger mb-3"></div><label class="form-label">نام کاربری</label><input asp-for="UserName" class="form-control mb-3" autocomplete="username"><label class="form-label">رمز عبور</label><input asp-for="Password" type="password" class="form-control mb-4" autocomplete="current-password"><button class="btn btn-main w-100">ورود به سامانه</button></form></div></body></html>