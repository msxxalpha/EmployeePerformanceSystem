@model Indamin.Performance.Controllers.AccountController.LoginVm
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#102a43">
    <title>ورود به سامانه</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
</head>
<body class="login-page">
    <div class="login-card">
        <div class="login-logo" aria-hidden="true">↗</div>
        <div class="text-center mb-4">
            <div class="eyebrow">ایندامین سایپا</div>
            <h2 class="fw-bold mb-2">سامانه ارزیابی عملکرد</h2>
            <p class="text-muted small mb-0">ورود امن به پنل شخصی و مدیریتی</p>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="returnUrl">
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label class="form-label">نام کاربری</label>
                <input asp-for="UserName" class="form-control" autocomplete="username" inputmode="numeric" placeholder="شماره پرسنلی یا admin">
            </div>
            <div class="mb-4">
                <label class="form-label">رمز عبور</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="رمز عبور خود را وارد کنید">
            </div>

            <button class="btn btn-main w-100 py-2">ورود به سامانه</button>
        </form>

        <div class="mt-4 p-3 rounded-3" style="background:#f5f8fa;border:1px solid #e5edf2">
            <div class="small fw-bold mb-1" style="color:#526d82">اطلاعات ورود کارکنان</div>
            <div class="form-hint">نام کاربری: شماره پرسنلی &nbsp; | &nbsp; رمز اولیه: کد ملی</div>
        </div>
    </div>
</body>
</html>