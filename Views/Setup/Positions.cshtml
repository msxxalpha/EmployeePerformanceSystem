@model List<Position>
@{ ViewData["Title"]="رده‌های پستی"; }
<div class="page-header"><div><div class="eyebrow">اطلاعات پایه</div><h2>رده‌های پستی</h2><p class="text-muted">سقف کل هر رده از مجموع سقف سؤال‌های متصل محاسبه می‌شود.</p></div><a class="btn btn-main" href="/Setup/Questions">بانک سؤالات</a></div>
<div class="form-panel mb-4"><div class="panel-title"><div><h4>ایجاد رده پستی</h4><span>ابتدا رده را ایجاد کنید؛ سپس سؤال‌ها را به آن متصل نمایید.</span></div></div>
<form method="post" action="/Setup/AddPosition" class="row g-3">@Html.AntiForgeryToken()<div class="col-md-3"><label class="form-label">کد رده *</label><input name="code" class="form-control" required></div><div class="col-md-6"><label class="form-label">عنوان رده *</label><input name="title" class="form-control" required></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-main w-100">ثبت رده پستی</button></div></form></div>
<div class="row g-3">@foreach(var p in Model){<div class="col-xl-6"><div class="table-panel h-100"><div class="card-heading"><div><span class="eyebrow">@p.Code</span><h4>@p.Title</h4></div><div class="score-total"><span>سقف کل</span><b>@p.QuestionMappings.Where(x=>x.IsActive).Sum(x=>x.MaxScore).ToString("0.##")</b></div></div>@if(!p.QuestionMappings.Any(x=>x.IsActive)){<div class="empty-inline">هیچ سؤال فعالی متصل نیست.</div>}else{<div class="table-responsive"><table class="table modern-table"><thead><tr><th>سؤال</th><th>حوزه</th><th>سقف</th><th>ترتیب</th></tr></thead><tbody>@foreach(var m in p.QuestionMappings.Where(x=>x.IsActive).OrderBy(x=>x.SortOrder)){<tr><td>@m.Question?.Title</td><td><span class="domain-chip">@m.Question?.Domain</span></td><td>@m.MaxScore</td><td>@m.SortOrder</td></tr>}</tbody></table></div>}</div></div>}</div>