@model List<Position>
@{ ViewData["Title"]="رده‌های پستی"; }
<div class="page-header">
  <div><div class="eyebrow">اطلاعات پایه</div><h2>رده‌های پستی</h2><p class="text-muted">سقف کل هر رده از مجموع سقف سؤال‌های فعال متصل محاسبه می‌شود.</p></div>
  <div class="toolbar-actions"><a class="btn btn-outline-secondary" href="/Setup/ExportPositions">خروجی Excel</a><a class="btn btn-main" href="/Setup/Questions">بانک سؤالات</a></div>
</div>
<div class="form-panel mb-4">
  <div class="panel-title"><div><h4>ایجاد رده پستی</h4><span>ابتدا رده را ایجاد کنید؛ سپس سؤال‌ها را به آن متصل نمایید.</span></div></div>
  <form method="post" action="/Setup/AddPosition" class="row g-3">@Html.AntiForgeryToken()
    <div class="col-md-4"><label class="form-label">کد رده *</label><input name="code" class="form-control" maxlength="50" placeholder="P-01" required></div>
    <div class="col-md-5"><label class="form-label">عنوان رده *</label><input name="title" class="form-control" maxlength="200" placeholder="کارشناس" required></div>
    <div class="col-md-3 d-flex align-items-end"><button class="btn btn-main w-100" type="submit">ثبت رده پستی</button></div>
  </form>
</div>
<div class="row g-3">
@foreach(var p in Model){
    var activeMappings = p.QuestionMappings.Where(x=>x.IsActive).OrderBy(x=>x.SortOrder).ToList();
    var mappedQuestionIds = activeMappings.Select(x=>x.QuestionId).ToHashSet();
    var availableQuestions = p.QuestionMappings.Count == 0
        ? ViewBag.AvailableQuestions as List<Question> ?? new List<Question>()
        : ViewBag.AvailableQuestions as List<Question> ?? new List<Question>();
    <div class="col-xl-6"><div class="table-panel h-100">
        <div class="card-heading"><div><span class="eyebrow">@p.Code</span><h4>@p.Title</h4><small class="text-muted">مدیریت سؤال‌های اختصاصی این رده</small></div><div class="score-total"><span>سقف کل</span><b>@activeMappings.Sum(x=>x.MaxScore).ToString("0.##")</b></div></div>

        <div class="mapping-add-box">
            <div class="mapping-add-title"><b>افزودن سؤال به این رده</b><span>سؤال موجود را انتخاب و سقف امتیاز مخصوص این رده را تعیین کنید.</span></div>
            <form method="post" action="/Setup/AssignQuestion" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="positionId" value="@p.Id">
                <div class="col-12"><label class="form-label">سؤال</label>
                    <select name="questionId" class="form-select" required>
                        <option value="">انتخاب سؤال</option>
                        @foreach(var q in availableQuestions.Where(x=>x.IsActive && !mappedQuestionIds.Contains(x.Id)).OrderBy(x=>x.Title))
                        {
                            <option value="@q.Id">@q.Code — @q.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-6"><label class="form-label">سقف امتیاز</label><input name="maxScore" class="form-control" type="number" min=".01" step=".01" required></div>
                <div class="col-md-3"><label class="form-label">ترتیب</label><input name="sortOrder" class="form-control" type="number" min="1" value="@(activeMappings.Count+1)"></div>
                <div class="col-md-3"><button class="btn btn-main w-100" type="submit">افزودن</button></div>
            </form>
        </div>

        @if(activeMappings.Count==0)
        {
            <div class="empty-inline">هیچ سؤال فعالی متصل نیست.</div>
        }
        else
        {
            <div class="table-responsive"><table class="table modern-table position-question-table"><thead><tr><th>سؤال</th><th>حوزه</th><th>سقف</th><th>ترتیب</th><th>عملیات</th></tr></thead><tbody>
            @foreach(var m in activeMappings)
            {
                <tr>
                    <td><b>@m.Question?.Title</b><div class="question-code">@m.Question?.Code</div></td>
                    <td><span class="domain-chip">@m.Question?.EvaluationDomain?.Title</span></td>
                    <td colspan="2">
                        <form method="post" action="/Setup/UpdateQuestionMapping" class="mapping-edit-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="mappingId" value="@m.Id">
                            <input name="maxScore" class="form-control" type="number" min=".01" step=".01" value="@m.MaxScore.ToString("0.##")" title="سقف امتیاز">
                            <input name="sortOrder" class="form-control" type="number" min="1" value="@m.SortOrder" title="ترتیب">
                            <button class="btn btn-sm btn-outline-primary" type="submit">ویرایش</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" action="/Setup/RemoveQuestion" class="inline-form" onsubmit="return confirm('سؤال «@m.Question?.Title» از این رده پستی حذف شود؟');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="mappingId" value="@m.Id">
                            <button class="btn btn-sm btn-outline-danger" type="submit">حذف</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody></table></div>
        }
    </div></div>
}
</div>