@model List<Position>
@{ ViewData["Title"] = "رده‌های پستی"; }<h2>رده‌های پستی و سؤالات</h2><div class="card p-3 mb-4"><form method="post" action="/Setup/AddPosition" class="row g-2"><div class="col-md-3"><input name="code" class="form-control" placeholder="کد رده" required></div><div class="col-md-5"><input name="title" class="form-control" placeholder="عنوان رده" required></div><div class="col-md-2"><input name="maxScore" class="form-control" value="100" type="number"></div><div class="col-md-2"><button class="btn btn-main w-100">افزودن</button></div></form></div>@foreach(var p in Model){<div class="card p-3 mb-3"><h5>@p.Code - @p.Title</h5><table class="table table-sm"><thead><tr><th>سؤال</th><th>حداکثر</th><th>ترتیب</th></tr></thead><tbody>@foreach(var q in p.Questions.OrderBy(x=>x.SortOrder)){<tr><td>@q.Text</td><td>@q.MaxScore</td><td>@q.SortOrder</td></tr>}</tbody></table><form method="post" action="/Setup/AddQuestion" class="row g-2"><input type="hidden" name="positionId" value="@p.Id"><div class="col-md-6"><input name="text" class="form-control" placeholder="متن سؤال"></div><div class="col-md-2"><input name="maxScore" class="form-control" placeholder="حداکثر" type="number"></div><div class="col-md-2"><input name="sortOrder" class="form-control" value="1" type="number"></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">افزودن سؤال</button></div></form></div>}