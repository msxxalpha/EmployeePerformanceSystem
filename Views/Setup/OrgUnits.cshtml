@model List<OrgUnit>
@{ ViewData["Title"] = "ساختار سازمانی"; }<h2>ساختار سازمانی</h2><div class="card p-3 mb-4"><form method="post" action="/Setup/AddOrgUnit" class="row g-2"><div class="col-md-3"><input name="code" class="form-control" placeholder="کد واحد" required></div><div class="col-md-5"><input name="title" class="form-control" placeholder="عنوان واحد" required></div><div class="col-md-2"><input name="parentId" class="form-control" placeholder="شناسه والد"></div><div class="col-md-2"><button class="btn btn-main w-100">افزودن</button></div></form></div><table class="table"><thead><tr><th>کد</th><th>عنوان</th><th>والد</th><th>فعال</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Code</td><td>@x.Title</td><td>@x.ParentId</td><td>@(x.IsActive?"بله":"خیر")</td></tr>}</tbody></table>