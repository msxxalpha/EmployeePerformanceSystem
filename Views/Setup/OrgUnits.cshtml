@model SetupController.OrgUnitsVm
@{ ViewData["Title"]="ساختار سازمانی"; }
<div class="page-header">
  <div><div class="eyebrow">ساختار سازمان</div><h2>واحدهای سازمانی</h2><p class="text-muted">واحدهای سازمانی مستقل از زنجیره ارزیابی هستند؛ زنجیره ارزیابی با سرپرست مستقیم کارکنان تعریف می‌شود.</p></div>
  <a class="btn btn-outline-secondary" href="/Setup/ExportOrgUnits">خروجی Excel</a>
</div>
<div class="form-panel mb-4">
  <div class="panel-title"><div><h4>افزودن واحد سازمانی</h4><span>واحد والد برای نمایش ساختار سازمانی انتخاب می‌شود.</span></div></div>
  <form method="post" action="/Setup/AddOrgUnit" class="row g-3">@Html.AntiForgeryToken()
    <div class="col-md-3"><label class="form-label">کد واحد *</label><input name="code" class="form-control" maxlength="50" placeholder="U-01" required></div>
    <div class="col-md-5"><label class="form-label">عنوان واحد *</label><input name="title" class="form-control" maxlength="200" placeholder="مدیریت کیفیت" required></div>
    <div class="col-md-3"><label class="form-label">واحد والد</label><select name="parentId" class="form-select"><option value="">سطح اصلی</option>@foreach(var p in Model.ParentOptions){<option value="@p.Id">@p.Code — @p.Title</option>}</select></div>
    <div class="col-md-1 d-flex align-items-end"><button class="btn btn-main w-100" type="submit">+</button></div>
  </form>
</div>
<div class="toolbar"><input class="form-control table-search" data-table-filter="#units" placeholder="جست‌وجوی کد یا عنوان واحد..."><span class="form-hint">تعداد: @Model.Units.Count</span></div>
<div class="table-panel"><div class="table-responsive"><table id="units" class="table modern-table"><thead><tr><th>کد</th><th>عنوان</th><th>والد</th><th>وضعیت</th></tr></thead><tbody>
@foreach(var u in Model.Units){var parent=Model.Units.FirstOrDefault(x=>x.Id==u.ParentId);<tr><td>@u.Code</td><td class="fw-bold">@u.Title</td><td>@(parent?.Title??"—")</td><td><span class="status-chip @(u.IsActive?"status-open":"status-closed")">@(u.IsActive?"فعال":"غیرفعال")</span></td></tr>}
</tbody></table></div></div>