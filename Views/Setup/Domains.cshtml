@model List<EvaluationDomain>
@{ ViewData["Title"]="حوزه‌های ارزیابی"; }
<div class="page-header">
 <div><div class="eyebrow">اطلاعات پایه</div><h2>حوزه‌های ارزیابی</h2><p class="text-muted">حوزه‌ها به‌صورت آیتم‌های استاندارد تعریف می‌شوند و هنگام ایجاد سؤال از این فهرست انتخاب خواهند شد.</p></div>
 <div class="toolbar-actions"><a class="btn btn-outline-primary" href="/Setup/Questions">بانک سؤالات</a></div>
</div>
<div class="form-panel mb-4">
 <div class="panel-title"><div><h4>افزودن حوزه ارزیابی</h4><span>برای هر حوزه کد، عنوان و ترتیب نمایش تعیین کنید.</span></div><span class="panel-badge">اطلاعات پایه</span></div>
 <form method="post" action="/Setup/AddDomain" class="row g-3">@Html.AntiForgeryToken()
  <div class="col-lg-2 col-md-4"><label class="form-label">کد *</label><input name="code" class="form-control" placeholder="DOM-01" maxlength="50" required></div>
  <div class="col-lg-4 col-md-8"><label class="form-label">عنوان *</label><input name="title" class="form-control" placeholder="کیفیت" maxlength="200" required></div>
  <div class="col-lg-4 col-md-6"><label class="form-label">توضیحات</label><input name="description" class="form-control" placeholder="شرح حوزه"></div>
  <div class="col-lg-1 col-md-3"><label class="form-label">ترتیب</label><input name="sortOrder" type="number" min="1" value="1" class="form-control"></div>
  <div class="col-lg-1 col-md-3 d-flex align-items-end"><button class="btn btn-main w-100" type="submit">+</button></div>
 </form>
</div>
<div class="toolbar"><input class="form-control table-search" data-table-filter="#domains" placeholder="جست‌وجوی کد یا عنوان..."><span class="form-hint">تعداد: @Model.Count</span></div>
<div class="table-panel"><div class="table-responsive"><table id="domains" class="table modern-table"><thead><tr><th>کد</th><th>عنوان</th><th>توضیحات</th><th>ترتیب</th><th>وضعیت</th><th>ویرایش</th><th></th></tr></thead><tbody>
@foreach(var d in Model){<tr>
<td><span class="code-chip">@d.Code</span></td><td class="fw-bold">@d.Title</td><td class="text-muted">@d.Description</td><td>@d.SortOrder</td><td><span class="status-chip @(d.IsActive?"status-open":"status-closed")">@(d.IsActive?"فعال":"غیرفعال")</span></td>
<td>
<form method="post" action="/Setup/EditDomain" class="domain-edit-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Id"><input name="code" value="@d.Code" class="form-control form-control-sm"><input name="title" value="@d.Title" class="form-control form-control-sm"><input name="description" value="@d.Description" class="form-control form-control-sm"><input name="sortOrder" type="number" min="1" value="@d.SortOrder" class="form-control form-control-sm"><label class="small"><input type="checkbox" name="isActive" value="true" @(d.IsActive?"checked":"")> فعال</label><button class="btn btn-sm btn-outline-primary" type="submit">ذخیره</button></form>
</td>
<td>@if(!d.IsActive){<form method="post" action="/Setup/ToggleDomain" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">فعال‌سازی</button></form>}else{<form method="post" action="/Setup/ToggleDomain" class="inline-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Id"><button class="btn btn-sm btn-outline-secondary" type="submit">غیرفعال</button></form>}</td>
</tr>}
</tbody></table></div></div>